{
  "expo": {
    "name": "Bulos 3D",
    "slug": "bulos-3d",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.venstqs.bulos3d"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2f5be7",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.venstqs.bulos3d"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font"
    ],
    "scheme": "bulos3d",
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "e9142e41-5c3c-4c62-9b1f-330733d52242"
      }
    },
    "owner": "venstqs"
  }
}
