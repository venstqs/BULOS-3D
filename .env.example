# Frontend (Vite) — optional
# VITE_API=http://127.0.0.1:8000
# VITE_CESIUM_ION_TOKEN=          # use Cesium World Terrain instead of ArcGIS elevation
# VITE_MAPBOX_TOKEN=              # Terrain view uses Mapbox satellite and terrain tiles instead of free open data

# Backend — all optional
# BULOS_DATA_SOURCE=sim           # sim | live
# BULOS_SIM_SPEED=60
# DATABASE_URL=sqlite:///backend/data/bulos.db
# DATABASE_URL=postgresql+psycopg://bulos:secret@localhost/bulos   # TimescaleDB
# SEMAPHORE_API_KEY=
# SEMAPHORE_SENDER=BULOS3D
# BULOS_SMS_RECIPIENTS={"Barangay Health Worker": ["09171234567"]}
# MQTT_HOST=
# MQTT_PORT=1883
# CHIRPSTACK_APP_ID=
